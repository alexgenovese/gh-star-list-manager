# GitHub Stars Organizer - Environment Variables
# Copia questo file come .env e inserisci i tuoi valori

# === GITHUB ===
# Personal Access Token (genera: https://github.com/settings/tokens)
# Scope: public_repo (lettura) + public_repo (scrittura per unstar)
GITHUB_TOKEN=

# Username GitHub (opzionale, usato solo per info)
GITHUB_USERNAME=

# === API ===
# Rate limit richieste per pagina (max 100)
API_PER_PAGE=100

# Timeout richieste HTTP in secondi
API_TIMEOUT=30

# === SOGLIE CLASSIFICAZIONE (mesi) ===
# Repo con push meno recente di X mesi = attiva
THRESHOLD_ACTIVE_MONTHS=6

# Repo con push meno recente di X mesi = stabile
THRESHOLD_STABLE_MONTHS=18

# === OUTPUT ===
# Formato export: txt, json, csv
EXPORT_FORMAT=txt

# Mostra colori nel terminale (true/false)
COLORS_ENABLED=true

# === CATEGORIE ===
# Abilita categorizzazione automatica (true/false)
AUTO_CATEGORIZE=true

# Categorie custom separate da virgola (sovrascrive default)
# CUSTOM_CATEGORIES=Security/InfoSec, WebAssembly, Game Dev
CUSTOM_CATEGORIES=
